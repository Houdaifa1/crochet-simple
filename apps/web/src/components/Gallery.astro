---
import { Picture } from 'astro:assets';
import { sharpCapped } from '../lib/sizes';
import type { ImageMetadata } from 'astro';

interface Props {
  photos: { image: ImageMetadata; alt: string }[];
  // Pinterest "Save" for the page, only once the domain exists
  saveHref?: string | undefined;
}
const { photos, saveHref } = Astro.props;
const many = photos.length > 1;
---

<div class="gallery" data-pagefind-ignore>
  <div class="frame">
    <div class="track" tabindex={many ? 0 : undefined} aria-label={many ? 'Photos' : undefined}>
      {photos.map((p, i) => (
        <figure>
          <Picture
            src={p.image}
            alt={p.alt}
            formats={['avif', 'webp']}
            fallbackFormat="jpg"
            widths={[480, 720, 960, 1280]}
            sizes={sharpCapped('(min-width: 1000px) 700px, calc(100vw - 40px)')}
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : undefined}
          />
        </figure>
      ))}
    </div>
    {many && (
      <>
        <span class="count" aria-hidden="true">
          <b>1</b> / {photos.length}
        </span>
        <button class="play" type="button" aria-label="Pause the photos" hidden>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path class="i-pause" d="M8 6v12M16 6v12" />
            <path class="i-play" d="M8 5.5v13l11-6.5z" />
          </svg>
        </button>
      </>
    )}
    {saveHref && (
      <a class="save" href={saveHref} rel="noopener" target="_blank">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 3a9 9 0 0 0-3.3 17.4c-.1-.8-.2-2 0-2.9l1.2-5s-.3-.6-.3-1.5c0-1.4.8-2.4 1.8-2.4.8 0 1.2.6 1.2 1.4 0 .9-.5 2.1-.8 3.3-.2 1 .5 1.8 1.5 1.8 1.8 0 3.1-1.9 3.1-4.6 0-2.4-1.7-4.1-4.2-4.1-2.9 0-4.5 2.1-4.5 4.4 0 .9.3 1.8.8 2.3l.1.4-.3 1.2c0 .2-.2.3-.4.2-1.3-.6-2.1-2.5-2.1-4 0-3.3 2.4-6.3 6.9-6.3 3.6 0 6.4 2.6 6.4 6 0 3.6-2.3 6.5-5.4 6.5-1.1 0-2.1-.6-2.4-1.2l-.7 2.5c-.2.9-.9 2.1-1.3 2.8A9 9 0 1 0 12 3z" />
        </svg>
        Save
        <span class="visually-hidden"> on Pinterest (opens in a new tab)</span>
      </a>
    )}
  </div>
  {many && (
    <div class="thumbs">
      {photos.map((p, i) => (
        <button
          type="button"
          aria-label={`Show photo ${i + 1}`}
          aria-current={i === 0 ? 'true' : 'false'}
        >
          <Picture
            src={p.image}
            alt=""
            formats={['avif', 'webp']}
            fallbackFormat="jpg"
            widths={[128, 192]}
            sizes="64px"
            loading="lazy"
          />
        </button>
      ))}
    </div>
  )}
</div>

<script>
  for (const g of document.querySelectorAll<HTMLElement>('.gallery')) {
    const track = g.querySelector<HTMLElement>('.track')!;
    const count = g.querySelector('.count b');
    const thumbs = [...g.querySelectorAll<HTMLButtonElement>('.thumbs button')];
    if (!thumbs.length) continue;
    let shown = 0;
    const update = () => {
      const i = Math.round(track.scrollLeft / track.clientWidth);
      if (i === shown) return;
      shown = i;
      if (count) count.textContent = String(i + 1);
      thumbs.forEach((t, k) => t.setAttribute('aria-current', String(k === i)));
    };
    track.addEventListener('scroll', () => requestAnimationFrame(update), { passive: true });
    thumbs.forEach((t, k) =>
      t.addEventListener('click', () =>
        track.scrollTo({ left: k * track.clientWidth, behavior: 'smooth' }),
      ),
    );

    // the photos move on by themselves until the visitor takes over, while the gallery is on screen
    const play = g.querySelector<HTMLButtonElement>('.play')!;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) continue;
    let paused = false;
    let seen = false;
    let timer = 0;
    const tick = () => {
      const next = (shown + 1) % thumbs.length;
      track.scrollTo({ left: next * track.clientWidth, behavior: 'smooth' });
    };
    const sync = () => {
      clearInterval(timer);
      if (!paused && seen && document.visibilityState === 'visible')
        timer = window.setInterval(tick, 4000);
      play.setAttribute('aria-label', paused ? 'Play the photos' : 'Pause the photos');
      play.classList.toggle('paused', paused);
    };
    const stop = () => {
      paused = true;
      sync();
    };
    play.hidden = false;
    play.addEventListener('click', () => {
      paused = !paused;
      sync();
    });
    for (const type of ['pointerdown', 'wheel', 'keydown', 'touchstart'])
      track.addEventListener(type, stop, { passive: true });
    thumbs.forEach((t) => t.addEventListener('click', stop));
    new IntersectionObserver(
      ([e]) => {
        seen = Boolean(e?.isIntersecting);
        sync();
      },
      { threshold: 0.6 },
    ).observe(track);
    document.addEventListener('visibilitychange', sync);
  }
</script>

<style>
  .gallery {
    margin: 24px 0 0;
  }
  .frame {
    position: relative;
    margin: 0 calc(var(--gutter) * -1);
  }
  .track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }
  .track::-webkit-scrollbar {
    display: none;
  }
  figure {
    flex: 0 0 100%;
    margin: 0;
    padding: 0 var(--gutter);
    scroll-snap-align: start;
  }
  figure :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 16px;
    background: #e6dccd;
  }
  .count {
    position: absolute;
    right: calc(var(--gutter) + 12px);
    bottom: 12px;
    padding: 6px 9px;
    border-radius: 2px;
    background: rgb(42 41 37 / 0.72);
    color: #fff;
    font: 600 12px/1 var(--sans);
  }
  .play {
    position: absolute;
    right: calc(var(--gutter) + 60px);
    bottom: 2px;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 2px;
    background: rgb(42 41 37 / 0.72);
    color: #fff;
    cursor: pointer;
  }
  .play[hidden] {
    display: none;
  }
  .play svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .play .i-play,
  .play.paused .i-pause {
    display: none;
  }
  .play.paused .i-play {
    display: inline;
    fill: currentColor;
    stroke: none;
  }
  .save {
    position: absolute;
    top: 12px;
    right: calc(var(--gutter) + 12px);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 44px;
    padding: 0 16px 0 12px;
    border-radius: 3px;
    background: #e60023;
    color: #fff;
    font: 700 14px/1 var(--sans);
    text-decoration: none;
  }
  .save svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }
  .thumbs {
    display: flex;
    gap: 10px;
    margin: 12px 0 0;
  }
  .thumbs button {
    width: 64px;
    height: 64px;
    padding: 0;
    border: 0;
    border-radius: 10px;
    overflow: hidden;
    opacity: 0.55;
    cursor: pointer;
    background: none;
    transition: opacity 0.2s;
  }
  .thumbs button[aria-current='true'] {
    opacity: 1;
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }
  .thumbs :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (min-width: 1000px) {
    .frame {
      margin: 0;
    }
    figure {
      padding: 0;
    }
    .count,
    .save {
      right: 12px;
    }
  }
</style>
