---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { HERO, PRODUCTS } from '../data/story.ts';
import { homepage } from '../lib/content';

// the admin's words, with the original wording wherever a field is empty
const h = await homepage();
const words = (h.headline ?? 'Every piece begins with').split(/\s+/).filter(Boolean);
const accent = (h.headlineAccent ?? 'one thread.').split(/\s+/).filter(Boolean);
const products = PRODUCTS.map((p, i) => {
  const own = h.products[i];
  return {
    ...p,
    name: own?.name ?? p.name,
    description: own?.description ?? p.description,
    tags: own?.tags ?? p.tags,
    alt: own?.alt ?? p.alt,
  };
});
const site = Astro.site;
const jsonLd = site
  ? [
      {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: 'Crochet Simple',
        url: site.href,
        potentialAction: {
          '@type': 'SearchAction',
          target: `${new URL('/search/', site).href}?q={query}`,
          'query-input': 'required name=query',
        },
      },
      {
        '@context': 'https://schema.org',
        '@type': 'Organization',
        name: 'Crochet Simple',
        url: site.href,
        logo: new URL('/apple-touch-icon.png', site).href,
      },
    ]
  : [];
const photoSizes = '(min-width: 1320px) 588px, (min-width: 900px) 45vw, calc(100vw - 72px)';
const detailSizes = '(min-width: 900px) 170px, 110px';
---

<Base
  title={h.seoTitle ?? 'Crochet Simple | Crochet patterns and tutorials'}
  description={
    h.seoDescription ??
    'Follow one thread as it becomes seven crochet designs, then find clear crochet patterns, tutorials and notes from the studio.'
  }
  current="home"
  jsonLd={jsonLd}
>
  <div class="tint" aria-hidden="true"></div>
  <div class="story">
    <section class="hero" aria-labelledby="hero-title" data-tint="var(--paper)">
      <div class="hero-text">
        <h1 id="hero-title">
          {words.map((w, i) => (
            <span class="w" style={`--d:${0.05 + i * 0.07}s`}>
              {w}{' '}
            </span>
          ))}
          <em>
            {accent.map((w, i) => (
              <span class="w" style={`--d:${0.05 + (words.length + i) * 0.07 + 0.05}s`}>
                {w}
                {i < accent.length - 1 ? ' ' : ''}
              </span>
            ))}
          </em>
        </h1>
      </div>
      <figure
        class="hero-photo"
        data-yarn-x={HERO.yarnEnd.x / HERO.photo.width}
        data-yarn-y={HERO.yarnEnd.y / HERO.photo.height}
        data-yarn-dx={HERO.yarnDirection.x}
        data-yarn-dy={HERO.yarnDirection.y}
      >
        <Picture
          src={HERO.photo}
          alt={HERO.alt}
          formats={['avif', 'webp']}
          fallbackFormat="jpg"
          widths={[400, 640, 900, 1254]}
          sizes="(min-width: 900px) 560px, calc(100vw - 48px)"
          loading="eager"
          fetchpriority="high"
        />
      </figure>
      <p class="cue">
        <span class="cue-thread" aria-hidden="true">
          <svg viewBox="0 0 22 44">
            <path d="M11 3 C 2 13, 20 25, 11 41"></path>
          </svg>
          <i class="bead"></i>
        </span>
        <span>{h.cue ?? 'Scroll to follow the thread'}</span>
      </p>
    </section>

    {products.map((p, i) => (
      <section
        class:list={['chapter', { flip: i % 2 === 1 }]}
        data-id={p.id}
        data-tint={p.tint}
        aria-labelledby={`name-${p.id}`}
      >
        <div class="art" aria-hidden="true" />
        <div class="stage">
          {p.details.map((d, k) => (
            <figure class={`float f${k + 1}`} aria-hidden="true">
              <Picture
                src={d}
                alt=""
                formats={['avif', 'webp']}
                fallbackFormat="jpg"
                widths={[160, 240, 360]}
                sizes={detailSizes}
              />
            </figure>
          ))}
          <figure class="photo">
            <Picture
              src={p.photo}
              alt={p.alt}
              formats={['avif', 'webp']}
              fallbackFormat="jpg"
              widths={[480, 720, 960, 1280, 1672]}
              sizes={photoSizes}
            />
          </figure>
        </div>
        <div class="meta">
          <span class="index" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          <h2 class="name" id={`name-${p.id}`}>
            {p.name}
          </h2>
          <p class="desc">{p.description}</p>
          {p.tags.length > 0 && (
            <ul class="tags" aria-label="Details">
              {p.tags.map((t) => (
                <li>{t}</li>
              ))}
            </ul>
          )}
        </div>
      </section>
    ))}

    <section class="ending" aria-labelledby="ending-title" data-tint="var(--paper)">
      <div class="knot" aria-hidden="true"></div>
      <p class="eyebrow">{h.endingEyebrow ?? 'Crochet Simple'}</p>
      <h2 id="ending-title">
        {h.endingTitle ?? 'One thread.'} <em>{h.endingAccent ?? 'Endless things to make.'}</em>
      </h2>
      <p class="lede">
        {h.endingText ?? 'Clear patterns, step by step tutorials and notes from the studio.'}
      </p>
      <div class="actions">
        <a class="button" href="/patterns/">
          {h.primaryButton ?? 'Browse patterns'}
        </a>
        <a class="button quiet" href="/journal/">
          {h.secondaryButton ?? 'Read the journal'}
        </a>
      </div>
    </section>
  </div>
</Base>

<script>
  // each part of the story sets the page colour when it crosses the middle of the screen
  const tint = document.querySelector<HTMLElement>('.tint')!;
  const seen = new IntersectionObserver(
    (entries) => {
      for (const e of entries)
        if (e.isIntersecting) tint.style.backgroundColor = (e.target as HTMLElement).dataset.tint!;
    },
    { rootMargin: '-50% 0px -50% 0px' },
  );
  document.querySelectorAll('[data-tint]').forEach((el) => seen.observe(el));

  // the yarn is not needed for the first paint; fetch it once the page has loaded
  const start = () => import('../scripts/story.ts').then((m) => m.startStory());
  if (document.readyState === 'complete') start();
  else addEventListener('load', start, { once: true });
</script>

<style>
  /* below the paper grain */
  .tint {
    position: fixed;
    inset: 0;
    z-index: -2;
    background: var(--paper);
    transition: background-color 0.9s var(--ease-out);
    /* its own layer, so a colour change never repaints the page or the yarn */
    transform: translateZ(0);
    contain: strict;
  }
  @media (prefers-reduced-motion: reduce) {
    .tint {
      transition: none;
    }
  }
  .story {
    position: relative;
    isolation: isolate;
  }
  /* above the yarn photo, so the line leaves from its loose strand; the route avoids every other photo */
  .story :global(.thread) {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    overflow: visible;
  }

  .hero {
    position: relative;
    z-index: 2;
    padding: 12px var(--gutter) 0;
  }
  h1 {
    margin: 22px 0 0;
    font-size: clamp(44px, 12.4vw, 104px);
    line-height: 0.96;
    letter-spacing: -0.035em;
    font-variation-settings: 'opsz' 144;
    text-wrap: balance;
  }
  h1 em {
    font-style: italic;
    color: var(--blue);
  }
  .w {
    display: inline-block;
    opacity: 0;
    transform: translateY(0.35em);
    animation: rise 0.8s var(--ease-out) var(--d) forwards;
    white-space: pre;
  }
  .hero-photo {
    margin: 28px 0 0;
    border-radius: 16px;
    overflow: hidden;
    background: #d9cbb6;
    box-shadow: 0 22px 44px -24px rgb(42 41 37 / 0.5);
  }
  .hero-photo :global(img) {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }

  .cue {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 20px 0 0;
    font: 500 16px/1.2 var(--sans);
    transition:
      opacity 0.45s,
      transform 0.45s;
  }
  .cue > * {
    opacity: 0;
    transform: translateY(12px);
    animation: rise 0.8s var(--ease-out) 0.75s forwards;
  }
  :global(.scrolled) .cue {
    opacity: 0;
    transform: translateY(10px);
  }
  .cue-thread {
    position: relative;
    flex: none;
    width: 22px;
    height: 44px;
  }
  .cue svg {
    display: block;
    width: 22px;
    height: 44px;
    overflow: visible;
  }
  .cue path {
    fill: none;
    stroke: rgb(42 41 37 / 0.3);
    stroke-width: 1.5;
    stroke-linecap: round;
  }
  .bead {
    position: absolute;
    left: 0;
    top: 0;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--pink);
    box-shadow: 0 0 0 2px #fffdf9;
    offset-path: path('M11 3 C 2 13, 20 25, 11 41');
    offset-anchor: center;
    offset-rotate: 0deg;
    animation: bead 2s cubic-bezier(0.55, 0, 0.35, 1) infinite;
  }
  @keyframes bead {
    0% {
      offset-distance: 0%;
      opacity: 0;
    }
    15% {
      opacity: 1;
    }
    75% {
      offset-distance: 100%;
      opacity: 1;
    }
    100% {
      offset-distance: 100%;
      opacity: 0;
    }
  }
  @keyframes rise {
    to {
      opacity: 1;
      transform: none;
    }
  }

  .chapter {
    position: relative;
    z-index: 2;
    padding: 22svh var(--gutter) 0;
  }
  .hero + .chapter {
    padding-top: 12svh;
  }
  .art {
    height: 40svh;
  }
  .stage {
    position: relative;
    margin: 52px 12px 0;
  }
  .photo {
    position: relative;
    z-index: 2;
    margin: 0;
    border-radius: 16px;
    overflow: hidden;
    background: #e6dccd;
    box-shadow: 0 22px 44px -24px rgb(42 41 37 / 0.5);
    transform-origin: 50% 60%;
    will-change: transform;
  }
  .photo :global(img) {
    width: 100%;
    will-change: transform;
  }
  .float {
    position: absolute;
    z-index: 1;
    margin: 0;
    padding: 5px;
    border-radius: 12px;
    background: #fff;
    box-shadow: 0 14px 30px -16px rgb(42 41 37 / 0.45);
    transition: opacity 0.5s;
  }
  .float :global(img) {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 8px;
  }
  /* close-ups sit on the outer side, away from where the yarn runs */
  .f1 {
    top: -16%;
    right: -6%;
    width: 31%;
  }
  .f2 {
    bottom: 10%;
    right: -9%;
    width: 23%;
  }
  .flip .f1 {
    right: auto;
    left: -6%;
  }
  .flip .f2 {
    right: auto;
    left: -9%;
  }
  :global(html.js) .story:not(.ready) .float,
  :global(html.js) .story:not(.ready) .meta > * {
    opacity: 0;
  }
  :global(html.js) .story:not(.ready) .photo {
    transform: scale(0.88);
  }
  .story.measuring .photo,
  .story.measuring .photo :global(img),
  .story.measuring .float,
  .story.measuring .meta > * {
    transform: none !important;
  }

  .meta {
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: 4px 12px;
    margin: 30px 12px 0;
  }
  .index {
    grid-row: span 3;
    font: 500 18px/1.6 var(--serif);
    color: var(--blue);
    font-variant-numeric: lining-nums;
  }
  .name {
    margin: 0;
    font-size: 32px;
    line-height: 1.05;
    letter-spacing: -0.02em;
    font-variation-settings: 'opsz' 72;
  }
  .desc {
    margin: 6px 0 0;
    max-width: 32ch;
    color: var(--muted);
    text-wrap: pretty;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 8px;
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
  }
  .tags li {
    font: 500 14px/1.4 var(--sans);
    color: var(--muted);
  }
  /* the dot ends a line rather than starting the next one */
  .tags li:not(:last-child)::after {
    content: '·';
    margin-left: 8px;
  }

  .ending {
    position: relative;
    z-index: 2;
    padding: 26svh var(--gutter) 88px;
    text-align: center;
  }
  .knot {
    width: 1px;
    height: 1px;
    margin: 0 auto 40px;
  }
  .eyebrow {
    margin: 0;
    font: 600 15px/1.3 var(--sans);
    color: var(--blue);
  }
  .ending h2 {
    margin: 12px auto 16px;
    max-width: 12ch;
    font-size: clamp(42px, 11vw, 88px);
    line-height: 0.98;
    letter-spacing: -0.035em;
    font-variation-settings: 'opsz' 144;
    text-wrap: balance;
  }
  .ending em {
    font-style: italic;
    color: var(--blue);
  }
  .lede {
    margin: 0 auto;
    max-width: 34ch;
    font-size: 18px;
    color: var(--muted);
    text-wrap: pretty;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 12px 20px;
    margin-top: 26px;
  }

  @media (min-width: 900px) {
    .hero {
      display: grid;
      grid-template-columns: 5fr 6fr;
      grid-template-rows: 1fr auto 1fr;
      column-gap: 64px;
      max-width: 1320px;
      min-height: calc(100svh - 170px);
      margin: 0 auto;
    }
    .hero-text {
      grid-row: 1 / span 2;
      align-self: end;
    }
    h1 {
      font-size: clamp(64px, 6.6vw, 104px);
    }
    .hero-photo {
      grid-column: 2;
      grid-row: 1 / span 3;
      align-self: center;
      justify-self: end;
      width: 100%;
      max-width: 560px;
      margin: 0;
      border-radius: 20px;
    }
    .cue {
      grid-column: 1;
      grid-row: 3;
      align-self: start;
      margin-top: 28px;
    }
    .chapter {
      display: grid;
      grid-template-columns: repeat(12, 1fr);
      align-items: center;
      column-gap: 32px;
      max-width: 1320px;
      margin: 0 auto;
      padding-top: 20svh;
    }
    .hero + .chapter {
      padding-top: 0;
    }
    /* first drawing sits under the yarn photo, then sides alternate */
    .art {
      grid-column: 8 / span 5;
      grid-row: 1 / span 2;
      height: 46svh;
    }
    .stage,
    .meta {
      grid-column: 1 / span 6;
      margin-left: 0;
      margin-right: 0;
    }
    .stage {
      grid-row: 1;
      margin-top: 0;
    }
    .meta {
      grid-row: 2;
    }
    .flip .art {
      grid-column: 1 / span 5;
    }
    .flip .stage,
    .flip .meta {
      grid-column: 7 / span 6;
    }
    .f1,
    .flip .f1 {
      width: 27%;
      top: -14%;
    }
    .f2,
    .flip .f2 {
      width: 21%;
      bottom: 12%;
    }
    .f1 {
      right: auto;
      left: -8%;
    }
    .f2 {
      right: auto;
      left: -10%;
    }
    .flip .f1 {
      left: auto;
      right: -8%;
    }
    .flip .f2 {
      left: auto;
      right: -10%;
    }
    .photo {
      border-radius: 20px;
    }
    .name {
      font-size: 40px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .w,
    .cue > * {
      animation: none;
      opacity: 1;
      transform: none;
    }
    .bead {
      animation: none;
      offset-distance: 60%;
    }
  }
</style>
