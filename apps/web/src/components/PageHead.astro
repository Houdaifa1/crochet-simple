---
interface Props {
  eyebrow?: string | undefined;
  title: string;
  intro?: string | undefined;
}
const { eyebrow, title, intro } = Astro.props;
---

<header class="page-head">
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h1>
    {title}
    <svg class="loop" viewBox="0 0 60 44" aria-hidden="true" focusable="false">
      <path pathLength="1" d="M2 40c10-2 18-10 16-20S6 10 8 20s16 16 28 8S52 8 56 6"></path>
      <circle cx="56" cy="6" r="3.6"></circle>
    </svg>
  </h1>
  {intro && <p class="intro">{intro}</p>}
  <slot />
</header>

<style>
  .page-head {
    padding: 20px 0 8px;
  }
  .eyebrow {
    margin-bottom: 10px;
  }
  h1 {
    position: relative;
    display: inline-block;
    max-width: calc(100% - 0.9em);
    margin: 0;
    font-size: clamp(44px, 12.5vw, 96px);
    line-height: 0.96;
    letter-spacing: -0.035em;
    font-variation-settings: 'opsz' 144;
    text-wrap: balance;
  }
  .loop {
    position: absolute;
    right: -0.95em;
    bottom: 0.12em;
    width: 0.85em;
    height: 0.66em;
    overflow: visible;
  }
  .loop path {
    fill: none;
    stroke: var(--ink);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw 1.1s var(--ease-out) 0.3s forwards;
  }
  .loop circle {
    fill: var(--pink);
    opacity: 0;
    animation: pop 0.3s var(--ease-out) 1.3s forwards;
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes pop {
    to {
      opacity: 1;
    }
  }
  .intro {
    max-width: 36ch;
    margin: 18px 0 0;
    font-size: 19px;
    color: var(--muted);
    text-wrap: pretty;
  }
  @media (min-width: 900px) {
    .page-head {
      padding: 48px 0 12px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .loop path {
      animation: none;
      stroke-dashoffset: 0;
    }
    .loop circle {
      animation: none;
      opacity: 1;
    }
  }
</style>
