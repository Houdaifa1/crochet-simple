---
import LinkCards from './LinkCards.astro';
import { fileSize, type Pattern, type PdfInfo } from '../lib/content';

interface Props {
  slug: string;
  pdf: PdfInfo | null;
  etsyUrl?: string | undefined;
  etsyCard?: Pattern['data']['etsyCard'];
}
const { slug, pdf, etsyUrl, etsyCard } = Astro.props;
// a paid pattern shows the Etsy listing itself: photo, price and shop rating
const listing = pdf ? undefined : etsyCard;
const facts = pdf
  ? ['PDF', pdf.pages && `${pdf.pages} ${pdf.pages === 1 ? 'page' : 'pages'}`, fileSize(pdf.bytes)]
  : [];
---

{(pdf || etsyUrl) && (
  <section class="get" id="download" aria-labelledby="download-title" data-get>
    <h2 id="download-title">{pdf ? 'Download the free PDF' : 'Get the pattern'}</h2>
    <p class="lead">
      {pdf
        ? 'The whole pattern with all the photos, ready to save on your phone or print.'
        : 'The full pattern is available on Etsy.'}
    </p>
    {listing ? (
      <div class="listing">
        <LinkCards cards={[listing]} />
      </div>
    ) : pdf ? (
      <a class="btn" href={`/downloads/${slug}.pdf`} download>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 4v11m0 0-4.5-4.5M12 15l4.5-4.5M5 19.5h14" />
        </svg>
        Download free PDF
      </a>
    ) : (
      <a class="btn etsy" href={etsyUrl} rel="noopener" target="_blank">
        Get the pattern on Etsy
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M7 17 17 7M9 7h8v8" />
        </svg>
        <span class="visually-hidden"> (opens in a new tab)</span>
      </a>
    )}
    {pdf && <p class="fine">{facts.filter(Boolean).join(' · ')}</p>}
  </section>
)}

<style>
  .get {
    margin: 56px 0 0;
    padding: 30px 22px;
    border-radius: 6px;
    background: var(--ink);
    color: #fbf7f0;
    text-align: center;
    scroll-margin-top: 90px;
  }
  h2 {
    margin: 0 0 8px;
    font-size: 32px;
  }
  .lead {
    margin: 0 auto 20px;
    max-width: 34ch;
    color: rgb(251 247 240 / 0.78);
  }
  .btn:not(.etsy) {
    background: #fbf7f0;
    color: var(--ink);
  }
  .etsy {
    background: #f1641e;
  }
  .fine {
    margin: 12px 0 0;
    font-size: 14px;
    color: rgb(251 247 240 / 0.72);
  }
  /* the Etsy card keeps its own dark text inside the dark box */
  .listing {
    max-width: 520px;
    margin: 0 auto;
    color: var(--ink);
    text-align: left;
  }
  .listing :global(.cards) {
    margin: 0;
  }
</style>
