---
import { Picture } from 'astro:assets';
import type { Pattern } from '../lib/content';
import { sharpCapped } from '../lib/sizes';

interface Props {
  video: NonNullable<Pattern['data']['video']>;
}
const { video } = Astro.props;
---

<section class="video" aria-labelledby="video-title" data-pagefind-ignore>
  <h2 id="video-title">Watch the video</h2>
  <div class="frame" data-yt={video.id} data-title={video.title}>
    <Picture
      src={video.thumbnail}
      alt=""
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      widths={[480, 720, 960]}
      sizes={sharpCapped('(min-width: 900px) 760px, 100vw')}
      loading="lazy"
    />
    <button class="play" type="button" aria-label={`Play the video: ${video.title}`}>
      <svg viewBox="0 0 68 48" aria-hidden="true">
        <path d="M27 15v18l16-9z" />
      </svg>
    </button>
  </div>
  <p class="caption">
    {video.title}
    <a href={video.url} rel="noopener" target="_blank">
      Watch on YouTube<span class="visually-hidden"> (opens in a new tab)</span>
    </a>
  </p>
</section>

<script>
  // YouTube loads only when someone presses play, so the page stays fast
  for (const frame of document.querySelectorAll<HTMLElement>('.video .frame')) {
    frame.querySelector('.play')?.addEventListener(
      'click',
      () => {
        const iframe = document.createElement('iframe');
        iframe.src = `https://www.youtube-nocookie.com/embed/${frame.dataset.yt}?autoplay=1&rel=0`;
        iframe.title = frame.dataset.title ?? 'Video';
        iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
        iframe.allowFullscreen = true;
        frame.replaceChildren(iframe);
      },
      { once: true },
    );
  }
</script>

<style>
  .video {
    margin: 2.2em 0 0;
  }
  h2 {
    margin: 0 0 14px;
    font: 500 26px/1.15 var(--serif);
    letter-spacing: -0.01em;
  }
  .frame {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 6px;
    background: #2a2925;
  }
  .frame :global(img),
  .frame :global(iframe) {
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: cover;
    display: block;
  }
  .play {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 76px;
    height: 54px;
    border: 0;
    border-radius: 14px;
    background: rgb(42 41 37 / 0.82);
    cursor: pointer;
    transition: background 0.2s;
  }
  .play:hover,
  .play:focus-visible {
    background: var(--blue);
  }
  .play svg {
    width: 100%;
    height: 100%;
    fill: #fff;
  }
  .caption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 4px 14px;
    margin: 10px 2px 0;
    font-size: 15px;
    color: var(--muted);
  }
  .caption a {
    color: var(--blue);
    font-weight: 600;
  }
</style>
