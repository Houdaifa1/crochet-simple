---
import { Picture } from 'astro:assets';
import { sharpCapped } from '../lib/sizes';
import { isFree, SKILL, type Pattern } from '../lib/content';

interface Props {
  pattern: Pattern;
  category: string;
  // on screen when the page opens: loaded at once, and drawn with the page instead of a moment later
  eager?: boolean;
  // the first card is usually the largest thing on screen, so it downloads first
  priority?: boolean;
  headingLevel?: 2 | 3;
  imageSizes?: string;
}
const {
  pattern,
  category,
  eager = false,
  priority = false,
  headingLevel = 2,
  imageSizes = '(min-width: 1240px) 249px, (min-width: 1100px) calc((100vw - 244px) / 4), (min-width: 900px) calc((100vw - 206px) / 3), (min-width: 700px) calc((100vw - 142px) / 3), (min-width: 431px) calc((100vw - 104px) / 2), calc((100vw - 88px) / 2)',
} = Astro.props;
const d = pattern.data;
const free = isFree(pattern);
const H = `h${headingLevel}` as 'h2' | 'h3';
---

<a class="card rise" href={`/patterns/${pattern.id}/`} data-free={free ? '' : undefined} data-ahead>
  <div class="media">
    <Picture
      src={d.cover}
      alt=""
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      widths={[192, 288, 384, 576, 768]}
      sizes={sharpCapped(imageSizes)}
      loading={eager ? 'eager' : 'lazy'}
      decoding={eager ? 'auto' : 'async'}
      fetchpriority={priority ? 'high' : undefined}
    />
    {free && <span class="badge free">Free PDF</span>}
    {!free && d.etsyUrl && <span class="badge etsy">On Etsy</span>}
  </div>
  <H class="title">{d.title}</H>
  <p class="meta">
    {category}
    {d.details.skill && ` · ${SKILL[d.details.skill]}`}
  </p>
</a>

<style>
  .card {
    display: block;
    text-decoration: none;
    border-radius: 16px;
  }
  .media {
    position: relative;
    overflow: hidden;
    border-radius: 16px;
    background: #e6dccd;
    aspect-ratio: 4 / 5;
  }
  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s var(--ease-out);
  }
  :global(html.js) .card:not(.in) .media :global(img) {
    transform: scale(1.06);
  }
  .card:hover .media :global(img) {
    transform: scale(1.035);
  }
  .badge {
    position: absolute;
    left: 10px;
    top: 10px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 9px;
    border-radius: 2px;
    background: rgb(251 248 242 / 0.95);
    font: 700 12px/1 var(--sans);
    color: var(--ink);
  }
  .badge.free {
    color: #a1004a;
  }
  .badge.etsy {
    color: #9a3a0a;
  }
  .title {
    margin: 12px 0 2px;
    font-size: 20px;
    line-height: 1.15;
    letter-spacing: -0.015em;
  }
  .meta {
    margin: 0;
    font-size: 14px;
    color: var(--muted);
  }
</style>
