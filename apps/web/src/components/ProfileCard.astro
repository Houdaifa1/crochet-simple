---
import { Image } from 'astro:assets';
import type { Settings } from '../lib/content';

interface Props {
  profile: NonNullable<Settings['pinterest']>;
  compact?: boolean;
}
const { profile, compact = false } = Astro.props;
---

<a class:list={['profile', { compact }]} href={profile.url} rel="noopener me" target="_blank">
  {profile.image ? (
    <Image src={profile.image} alt="" width={112} height={112} class="avatar" loading="lazy" />
  ) : (
    <span class="avatar blank" aria-hidden="true" />
  )}
  <span class="text">
    <span class="kicker">Follow on Pinterest</span>
    <strong>{profile.name}</strong>
    {!compact && profile.description && <span class="desc">{profile.description}</span>}
  </span>
  <span class="follow" aria-hidden="true">
    Follow
  </span>
  <span class="visually-hidden"> (opens Pinterest in a new tab)</span>
</a>

<style>
  .profile {
    display: grid;
    grid-template-columns: 56px 1fr auto;
    align-items: center;
    gap: 14px;
    padding: 14px 16px;
    border-radius: 6px;
    background: var(--sheet);
    color: var(--ink);
    text-decoration: none;
    box-shadow:
      0 1px 0 rgb(42 41 37 / 0.1),
      0 18px 40px -30px rgb(42 41 37 / 0.45);
  }
  .compact {
    max-width: 420px;
  }
  .avatar {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    object-fit: cover;
  }
  .blank {
    background: #e60023;
  }
  .text {
    display: grid;
    gap: 2px;
    min-width: 0;
  }
  .kicker {
    font: 600 13px/1.2 var(--sans);
    color: #e60023;
  }
  strong {
    font: 400 20px/1.2 var(--serif);
  }
  .desc {
    font-size: 15px;
    color: var(--muted);
  }
  .follow {
    padding: 11px 16px;
    border-radius: 3px;
    background: #e60023;
    color: #fff;
    font: 700 14px/1 var(--sans);
  }
</style>
