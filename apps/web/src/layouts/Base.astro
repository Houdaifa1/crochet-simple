---
import { getImage } from 'astro:assets';
import '../styles/global.css';
import '../styles/glass.css';
import Dock from '../components/Dock.astro';
import Mark from '../components/Mark.astro';
import ProfileCard from '../components/ProfileCard.astro';
import SocialLinks from '../components/SocialLinks.astro';
import fontUrl from '../assets/fonts/fraunces.woff2?url';
import italicUrl from '../assets/fonts/fraunces-italic.woff2?url';
import { absolute, settings } from '../lib/content';
import { shareTitle } from '../lib/seo';
import heroPhoto from '../assets/story/00-yarn-hero.png';

interface Props {
  title: string;
  description: string;
  current: 'home' | 'patterns' | 'journal' | 'about' | 'none';
  // a path on this site; made absolute once the domain is set
  image?: string | undefined;
  type?: 'website' | 'article';
  published?: Date | undefined;
  modified?: Date | undefined;
  jsonLd?: object[];
  noindex?: boolean;
  ads?: boolean;
}
const {
  title,
  description,
  current,
  image,
  type = 'website',
  published,
  modified,
  jsonLd = [],
  noindex = false,
  ads = false,
} = Astro.props;
const site = Astro.site;
const s = await settings();
const canonical = absolute(Astro.url.pathname, site);
// pages without a photo of their own share the yarn photo, cut to the size social sites expect
const fallback = image
  ? undefined
  : await getImage({ src: heroPhoto, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const shareImage = absolute(image ?? fallback!.src, site);
const adClient = s.adsense.enabled && ads ? s.adsense.client : undefined;
const ld = (o: object) => JSON.stringify(o).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en-US" class="glass">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {/* open pages let search engines show large photo previews and full snippets */}
    <meta
      name="robots"
      content={
        noindex || !s.indexable
          ? s.indexable
            ? 'noindex, follow'
            : 'noindex, nofollow'
          : 'max-image-preview:large, max-snippet:-1, max-video-preview:-1'
      }
    />
    <meta name="theme-color" content="#fcf8f5" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={italicUrl} as="font" type="font/woff2" crossorigin />
    {canonical && <link rel="canonical" href={canonical} />}
    {site && (
      <link rel="alternate" type="application/rss+xml" title="Crochet Simplified" href="/rss.xml" />
    )}
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Crochet Simplified" />
    <meta property="og:title" content={shareTitle(title)} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="en_US" />
    {canonical && <meta property="og:url" content={canonical} />}
    {shareImage && <meta property="og:image" content={shareImage} />}
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {modified && <meta property="article:modified_time" content={modified.toISOString()} />}
    {type === 'article' && <meta property="article:author" content="Crochet Simplified" />}
    <meta name="twitter:card" content="summary_large_image" />
    {s.verification.google && (
      <meta name="google-site-verification" content={s.verification.google} />
    )}
    {s.verification.pinterest && <meta name="p:domain_verify" content={s.verification.pinterest} />}
    {jsonLd.map((o) => (
      <script type="application/ld+json" set:html={ld(o)} />
    ))}
    <script is:inline>
      document.documentElement.classList.add('js');
      // the menu slides in on the first page of a visit only, then simply stays
      try {
        if (sessionStorage.getItem('dock')) document.documentElement.classList.add('dock-seen');
        else sessionStorage.setItem('dock', '1');
      } catch {}
      // a page opened at a spot (a category, or a section from the menu) is shown only once it is there
      try {
        const back = JSON.parse(sessionStorage.getItem('tab-restore') || 'null');
        if (
          location.hash === '#patterns' ||
          (back && back.url === location.pathname + location.search)
        ) {
          const wait = document.createElement('link');
          wait.rel = 'expect';
          wait.href = '#page-end';
          wait.setAttribute('blocking', 'render');
          document.head.append(wait);
        }
      } catch {}
    </script>
    {adClient && (
      <script
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adClient}`}
        crossorigin="anonymous"
      />
    )}
    {s.analyticsToken && site && <script
      is:inline
      define:vars={{ beacon: JSON.stringify({ token: s.analyticsToken }) }}
    >
      // visits are counted once the page has loaded, so counting never slows the page
      addEventListener(
        'load',
        () => {
          const tag = document.createElement('script');
          tag.src = 'https://static.cloudflareinsights.com/beacon.min.js';
          tag.dataset.cfBeacon = beacon;
          document.head.append(tag);
        },
        { once: true },
      );
    </script>}
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="Crochet Simplified, home">
        <Mark />
        <span>
          Crochet <em>Simplified</em>
        </span>
      </a>
      <a
        class="header-search"
        href="/search/"
        aria-label={s.controls.searchLabel ?? 'Search patterns and stories'}
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="10.5" cy="10.5" r="6.5" />
          <path d="m16 16 4.5 4.5" />
        </svg>
      </a>
    </header>
    <Dock current={current} />
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      {s.pinterest && <ProfileCard profile={s.pinterest} compact />}
      <SocialLinks links={s.social} />
      <div class="footer-row">
        <span>© {new Date().getFullYear()} Crochet Simplified</span>
        <nav aria-label="Footer">
          <a href="/patterns/">Patterns</a>
          <a href="/journal/">Journal</a>
          <a href="/about/">About</a>
          <a href="/privacy/">Privacy</a>
          <a href="/terms/">Terms</a>
        </nav>
      </div>
    </footer>
    <script is:inline>
      // moved into place while the page is still hidden, so the first frame is already the right spot
      try {
        const back = JSON.parse(sessionStorage.getItem('tab-restore') || 'null');
        sessionStorage.removeItem('tab-restore');
        const row = document.getElementById('patterns');
        if (back && back.url === location.pathname + location.search)
          scrollTo({
            top:
              typeof back.row === 'number' && row
                ? row.getBoundingClientRect().top + scrollY - back.row
                : back.y,
            behavior: 'instant',
          });
        else if (location.hash === '#patterns')
          document
            .getElementById('patterns')
            ?.scrollIntoView({ block: 'start', behavior: 'instant' });
      } catch {}
    </script>
    <span id="page-end" hidden></span>
    <script>
      // Safari starts a picture only when it is almost on screen; once the page is up, start them
      // about a screen and a half ahead, and whole sliding rows as soon as the row comes near
      const net = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
      const ahead = () => {
        const near = new IntersectionObserver(
          (entries) =>
            entries.forEach((e) => {
              if (!e.isIntersecting) return;
              near.unobserve(e.target);
              const imgs = e.target.matches('img')
                ? [e.target as HTMLImageElement]
                : [...e.target.querySelectorAll<HTMLImageElement>('img[loading="lazy"]')];
              for (const img of imgs) img.loading = 'eager';
            }),
          { rootMargin: '150% 0px' },
        );
        const watched = new Set<Element>();
        for (const img of document.querySelectorAll('img[loading="lazy"]')) {
          const target = img.closest('[data-strip]') ?? img;
          if (!watched.has(target)) (watched.add(target), near.observe(target));
        }
      };
      if (!net?.saveData) {
        const idle = () =>
          'requestIdleCallback' in window
            ? requestIdleCallback(ahead, { timeout: 1200 })
            : setTimeout(ahead, 300);
        if (document.readyState === 'complete') idle();
        else addEventListener('load', idle, { once: true });
      }
    </script>
  </body>
</html>
