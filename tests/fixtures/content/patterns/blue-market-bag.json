        [
          {
            "text": "Cotton DK yarn in cobalt, about 300 g"
          }
        ],
        [
          {
            "text": "4.0 mm crochet hook"
          }
        ],
        [
          {
            "text": "Stitch markers and a "
          },
          {
            "text": "tapestry needle",
            "bold": true
          }
        ]
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "text": "Abbreviations"
    },
    {
      "type": "table",
      "rows": [
        ["ch", "chain"],
        ["sc", "single crochet"],
        ["inc", "2 sc in the same stitch"],
        ["sl st", "slip stitch"]
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "text": "Pattern"
    },
    {
      "type": "heading",
      "level": 3,
      "text": "Base"
    },
    {
      "type": "rounds",
      "items": [
        {
          "label": "Rnd 1",
          "text": "Ch 41, sc in 2nd ch from hook and across.",
          "count": "80 sts"
        },
        {
          "label": "Rnd 2",
          "text": "Inc in each of the first 3 sts, sc to the end.",
          "count": "86 sts"
        },
        {
          "label": "Rnd 3",
          "text": "Sc around, placing a marker at each side.",
          "count": "86 sts"
        }
      ]
    },
    {
      "type": "rounds",
      "title": "Finishing steps",
      "items": [
        {
          "label": "Join the handles",
          "text": "Test fixture text. Sew each handle end to the inside of the bag, two rounds below the top edge."
        },
        {
          "label": "Add the cherries",
          "text": "Test fixture text. Stitch the cherry stems together and sew them to the base of one handle.",
          "count": "2 cherries"
        }
      ]
    },
    {
