---
import AdSlot from '../../components/AdSlot.astro';
import Blocks from '../../components/Blocks.astro';
import Chips from '../../components/Chips.astro';
import PageHead from '../../components/PageHead.astro';
import Pager from '../../components/Pager.astro';
import PatternCard from '../../components/PatternCard.astro';
import Base from '../../layouts/Base.astro';
import { allCard, cardLook } from '../../lib/cards';
import { freeHeading, listTitle, needsFreePage, pagedDescription } from '../../lib/seo';
import {
  PAGE_SIZE,
  absolute,
  categories,
  isFree,
  listing,
  pageCount,
  patterns,
  type Category,
  type Pattern,
} from '../../lib/content';

export async function getStaticPaths() {
  const all = await patterns();
  const cats = await categories();
  const scopes: { category: Category | null; list: Pattern[] }[] = [
    { category: null, list: all },
    ...cats.map((c) => ({ category: c.category, list: c.patterns })),
  ];
  const names = new Map(cats.map((c) => [c.category.id, c.category.data.name]));
  const looks = new Map(
    await Promise.all(
      cats.map(async (c) => [c.category.id, await cardLook(c.category, c.patterns)] as const),
    ),
  );
  const hasFreePage = (list: Pattern[]) => needsFreePage(list.map(isFree));
  // categories whose "free only" page exists, for the chips on the free pages
  const freePages = cats.filter((c) => hasFreePage(c.patterns)).map((c) => c.category.id);
  return scopes.flatMap(({ category, list }) =>
    [false, true].flatMap((free) => {
      const shown = free ? list.filter(isFree) : list;
      if (free && !hasFreePage(list)) return [];
      const base = `/patterns/${category ? `category/${category.id}/` : ''}${free ? 'free/' : ''}`;
      const chips = cats
        .map((c) => ({
          category: c.category,
          count: (free ? c.patterns.filter(isFree) : c.patterns).length,
          look: looks.get(c.category.id)!,
        }))
        .filter((c) => c.count > 0);
      const freeHere = hasFreePage(list);
      const allFree = list.every(isFree);
      const pages = pageCount(shown.length);
      return Array.from({ length: pages }, (_, i) => {
        const n = i + 1;
        const rest = `${base.slice('/patterns/'.length)}${n > 1 ? `page/${n}/` : ''}`.replace(
          /\/$/,
          '',
        );
        return {
          params: { list: rest || undefined },
          props: {
            category,
            free,
            freeHere,
            allFree,
            freePages,
            base,
            page: n,
            pages,
            total: shown.length,
            items: shown
              .slice(i * PAGE_SIZE, n * PAGE_SIZE)
              .map((p) => ({ p, name: names.get(p.data.category.id)! })),
            chips,
            chipTotal: (free ? all.filter(isFree) : all).length,
          },
        };
      });
    }),
  );
}

const {
  category,
  free,
  freeHere,
  allFree,
  freePages,
  base,
  page,
  pages,
  total,
  items,
  chips,
  chipTotal,
} = Astro.props;
const name = category?.data.name;
const words = await listing('patterns');
const h1 = free ? freeHeading(name) : (name ?? words.title ?? 'Patterns');
const title = listTitle({
  name,
  seoTitle: category ? category.data.seoTitle : words.seoTitle,
  allFree,
  freeOnly: free,
  page,
  count: total,
});
// the category's longer write-up, on its first full page only so the numbered pages do not repeat it
const guide = category && !free && page === 1 ? category.data.guide : [];
// the admin's text when it is long enough to describe the page in search results
const own = category?.data.description;
const seoDescription = free
  ? undefined
  : (category?.data.seoDescription ?? (category ? undefined : words.seoDescription));
const firstDescription =
  seoDescription ??
  (own && own.length >= 70
    ? own
    : name
      ? `${free ? 'Free ' : ''}${name} crochet patterns from Crochet Simplified, with clear steps, good photos${free ? ' and a printable PDF' : ''}.`
      : free
        ? 'Free crochet patterns with clear steps, good photos and a printable PDF you can download right away.'
        : 'Crochet patterns with clear steps and good photos: bags, accessories, home pieces, hats and more.');
const description = pagedDescription(firstDescription, page, pages);
const intro = free
  ? 'Download the PDF, print it and start. No account needed.'
  : (category?.data.description ??
    words.intro ??
    'Clear steps, good photos and a finished piece you will actually use.');
const toggleHref = free
  ? `/patterns/${category ? `category/${category.id}/` : ''}`
  : `${base}free/`;
const site = Astro.site;
const crumbs = [
  { name: 'Patterns', path: '/patterns/' },
  ...(category ? [{ name: category.data.name, path: `/patterns/category/${category.id}/` }] : []),
  ...(free ? [{ name: 'Free', path: base }] : []),
];
const jsonLd = site
  ? [
      {
        '@context': 'https://schema.org',
        '@type': 'CollectionPage',
        name: h1,
        description,
        url: absolute(Astro.url.pathname, site),
        mainEntity: {
          '@type': 'ItemList',
          numberOfItems: total,
          itemListElement: items.map(({ p }, i) => ({
            '@type': 'ListItem',
            position: (page - 1) * PAGE_SIZE + i + 1,
            url: absolute(`/patterns/${p.id}/`, site),
            name: p.data.title,
          })),
        },
      },
      {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: crumbs.map((c, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: c.name,
          item: absolute(c.path, site),
        })),
      },
    ]
  : [];
---

<Base title={title} description={description} current="patterns" jsonLd={jsonLd} ads>
  <div class="wrap">
    <PageHead
      eyebrow={free ? 'Free crochet patterns' : (words.eyebrow ?? 'Crochet patterns')}
      title={h1}
      intro={intro}
    >
      <form class="search" role="search" action="/search/" method="get">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="11" cy="11" r="6.5"></circle>
          <path d="m16 16 4 4"></path>
        </svg>
        <label class="visually-hidden" for="q">
          Search patterns
        </label>
        <input id="q" name="q" type="search" placeholder="Search patterns" autocomplete="off" />
      </form>
    </PageHead>
    {total === 0 ? (
      <section class="empty">
        <h2>The first patterns are on their way</h2>
        <p>
          New patterns are added here as they are finished. The journal has tutorials to start with.
        </p>
        <a class="btn" href="/journal/">
          Read the journal
        </a>
      </section>
    ) : (
      <>
        {chips.length > 1 && (
          <Chips
            items={chips}
            all={allCard}
            total={chipTotal}
            current={category?.id ?? null}
            free={free}
            freePages={freePages}
          />
        )}
        <div class="bar" id={chips.length > 1 ? undefined : 'patterns'}>
          <p class="count" aria-live="polite">
            {total} {total === 1 ? 'pattern' : 'patterns'}
            {pages > 1 && ` · page ${page} of ${pages}`}
          </p>
          {freeHere && (
            <a class:list={['toggle', { on: free }]} href={`${toggleHref}#patterns`}>
              <span class="switch" aria-hidden="true" />
              Free only<span class="visually-hidden">{free ? ' (on, show all)' : ' (off)'}</span>
            </a>
          )}
        </div>
        <div class="grid">
          {items.map(({ p, name: cat }, i) => (
            <>
              <PatternCard pattern={p} category={cat} eager={i < 2} priority={i === 0} />
              {i === 3 && items.length > 4 && (
                <div class="feed-ad">
                  <AdSlot kind="inFeed" />
                </div>
              )}
            </>
          ))}
        </div>
        <section class="more" hidden aria-labelledby="more-title">
          <h2 id="more-title">More results</h2>
          <ol class="results" />
        </section>
        <Pager base={base} current={page} total={pages} anchor="patterns" />
      </>
    )}
    {guide.length > 0 && (
      <section class="guide prose">
        <Blocks blocks={guide} />
      </section>
    )}
  </div>
</Base>

<script>
  // the address is tidied only after the browser has finished opening the page at the list
  addEventListener(
    'load',
    () => {
      if (location.hash === '#patterns')
        history.replaceState(history.state, '', location.pathname + location.search);
    },
    { once: true },
  );
  const io = new IntersectionObserver(
    (entries) =>
      entries.forEach(
        (e) => e.isIntersecting && (e.target.classList.add('in'), io.unobserve(e.target)),
      ),
    { rootMargin: '0px 0px -6% 0px' },
  );
  document.querySelectorAll('.rise').forEach((el) => io.observe(el));
</script>

<script>
  // a category or the free switch changes the patterns in place, at once, like on a fast computer:
  // the page, the category row and its sideways spot stay put, and only what differs is swapped in
  const filters = document.querySelector<HTMLElement>('.filters');
  const grid = document.querySelector<HTMLElement>('.grid');
  if (filters && grid) {
    // each page's words are fetched once; they are read into a page only when one is about to be shown
    const sources = new Map<string, Promise<string>>();
    const pages = new Map<string, Promise<Document>>();
    const fetchPage = (path: string, priority: RequestPriority) => {
      let html = sources.get(path);
      if (!html) {
        html = fetch(path, { priority }).then((r) =>
          r.ok ? r.text() : Promise.reject(new Error(String(r.status))),
        );
        // a failed download is tried again on the next tap
        html.catch(() => sources.delete(path));
        sources.set(path, html);
      }
      return html;
    };
    const load = (path: string) => {
      let doc = pages.get(path);
      if (!doc) {
        doc = fetchPage(path, 'high').then((html) =>
          new DOMParser().parseFromString(html, 'text/html'),
        );
        doc.catch(() => pages.delete(path));
        pages.set(path, doc);
      }
      return doc;
    };
    const switches = () => [
      ...document.querySelectorAll<HTMLAnchorElement>('.chips a.chip, .bar a.toggle'),
    ];
    const plain = (e: MouseEvent) =>
      e.button === 0 && !e.metaKey && !e.ctrlKey && !e.shiftKey && !e.altKey;
    const ads = () =>
      (window as unknown as { adsbygoogle?: object[] }).adsbygoogle ??
      ((window as unknown as { adsbygoogle: object[] }).adsbygoogle = []);

    const show = (doc: Document) => {
      const row = filters.getBoundingClientRect().top;
      document.querySelector<HTMLElement>('.page-head')?.style.removeProperty('min-height');
      // one piece of the page for its counterpart on the other page, added or removed as needed
      const put = (selector: string, place: (el: Element) => void = () => undefined) => {
        const now = document.querySelector(selector);
        const next = doc.querySelector(selector);
        const copy = next && document.importNode(next, true);
        if (now && copy) now.replaceWith(copy);
        else if (copy) place(copy);
        else now?.remove();
      };
      document.title = doc.title;
      for (const tag of [
        'meta[name="description"]',
        'meta[name="robots"]',
        'link[rel="canonical"]',
        'meta[property="og:url"]',
        'meta[property="og:title"]',
        'meta[property="og:description"]',
      ])
        put(tag);
      document.head
        .querySelectorAll('script[type="application/ld+json"]')
        .forEach((s) => s.remove());
      doc.head
        .querySelectorAll('script[type="application/ld+json"]')
        .forEach((s) => document.head.append(document.importNode(s, true)));
      // the heading keeps its drawn loop; only its words change
      const words = (h: Element | null) =>
        [...(h?.childNodes ?? [])].find(
          (n) => n.nodeType === Node.TEXT_NODE && n.textContent?.trim(),
        );
      const heading = words(document.querySelector('.page-head h1'));
      const title = words(doc.querySelector('.page-head h1'));
      if (heading && title) heading.textContent = title.textContent;
      put('.page-head .eyebrow');
      put('.page-head .intro');
      // the row keeps its cards and where it was slid to; their links, counts and the open one follow
      const chips = filters.querySelector<HTMLElement>('.chips')!;
      const own = [...chips.querySelectorAll<HTMLAnchorElement>('a.chip')];
      const next = [...doc.querySelectorAll<HTMLAnchorElement>('.chips a.chip')];
      const ids = (all: HTMLElement[]) => all.map((c) => c.dataset['category']).join();
      if (ids(own) === ids(next))
        own.forEach((c, i) => {
          const n = next[i]!;
          c.setAttribute('href', n.getAttribute('href')!);
          if (n.hasAttribute('aria-current')) c.setAttribute('aria-current', 'page');
          else c.removeAttribute('aria-current');
          c.querySelector('.sum')!.innerHTML = n.querySelector('.sum')!.innerHTML;
        });
      else {
        const x = chips.scrollLeft;
        chips.replaceChildren(...next.map((c) => document.importNode(c, true)));
        chips.scrollLeft = x;
      }
      // the count is changed in place, so screen readers hear the new number
      const bar = document.querySelector('.bar')!;
      bar.querySelector('.count')!.textContent =
        doc.querySelector('.bar .count')?.textContent ?? '';
      put('.bar a.toggle', (el) => bar.append(el));
      // the ad already shown stays where it is instead of being asked for again
      const patterns = document.importNode(doc.querySelector('.grid')!, true);
      const ad = grid.querySelector('.feed-ad');
      if (ad) patterns.querySelector('.feed-ad')?.replaceWith(ad);
      grid.classList.remove('searching');
      grid.replaceChildren(...patterns.childNodes);
      grid.querySelectorAll('ins.adsbygoogle:not([data-adsbygoogle-status])').forEach(() => {
        try {
          ads().push({});
        } catch {}
      });
      const more = document.querySelector<HTMLElement>('.more');
      if (more) ((more.hidden = true), more.querySelector('ol')?.replaceChildren());
      put('.pager', (el) => (more ?? grid).after(el));
      put('.guide', (el) => (document.querySelector('.pager') ?? more ?? grid).after(el));
      // a heading of another length above the row is made up for, so the row does not move; near the top
      // of the page there is no room to scroll up, so a shorter one keeps the old height there instead
      const short = row - filters.getBoundingClientRect().top - scrollY;
      const room =
        document.querySelector<HTMLElement>('.page-head .intro') ??
        document.querySelector<HTMLElement>('.page-head');
      if (short > 0 && room)
        room.style.minHeight = `${room.getBoundingClientRect().height + short}px`;
      scrollBy(0, filters.getBoundingClientRect().top - row);
      document.dispatchEvent(new Event('patterns:swap'));
    };

    let shown = location.pathname;
    let turn = 0;
    const open = async (path: string, push: boolean) => {
      const mine = ++turn;
      grid.setAttribute('aria-busy', 'true');
      let doc: Document;
      try {
        doc = await load(path);
      } catch {
        // without a connection the address opens the ordinary way and says what is wrong
        location.assign(path);
        return;
      }
      if (mine !== turn) return;
      // a page without the list (no patterns yet) is opened the ordinary way
      if (!doc.querySelector('.filters .chips') || !doc.querySelector('.grid')) {
        location.assign(path);
        return;
      }
      grid.removeAttribute('aria-busy');
      show(doc);
      shown = path;
      if (push) history.pushState(null, '', path);
    };

    // the touched card is marked in the same frame, before anything else happens
    document.addEventListener(
      'click',
      (e) => {
        const a = (e.target as Element).closest<HTMLAnchorElement>('a');
        if (!a || !plain(e) || !switches().includes(a) || a.origin !== location.origin) return;
        e.preventDefault();
        if (a.matches('.chip')) {
          filters.querySelectorAll('a.chip').forEach((c) => c.removeAttribute('aria-current'));
          a.setAttribute('aria-current', 'page');
        } else a.classList.toggle('on', a.pathname.endsWith('/free/'));
        // the open category tapped again calls off one that is still on its way
        if (a.pathname === shown) {
          turn++;
          grid.removeAttribute('aria-busy');
          return;
        }
        open(a.pathname, true);
      },
      true,
    );
    // Back and Forward step through the categories the same way
    addEventListener('popstate', () => {
      if (location.pathname !== shown) open(location.pathname, false);
    });
    // a touch starts the download a moment before the tap ends, in case it is not here yet
    filters.addEventListener(
      'pointerdown',
      (e) => {
        const a = (e.target as Element).closest<HTMLAnchorElement>('a.chip');
        if (a) load(a.pathname).catch(() => undefined);
      },
      { passive: true },
    );
    // every category is fetched once the page is up, so a tap has it at hand
    const net = (
      navigator as Navigator & { connection?: { saveData?: boolean; effectiveType?: string } }
    ).connection;
    if (!net?.saveData && !/2g/.test(net?.effectiveType ?? '')) {
      const ahead = () =>
        switches()
          .filter((a) => a.pathname !== shown)
          .forEach((a) => fetchPage(a.pathname, 'low').catch(() => undefined));
      const idle = () =>
        'requestIdleCallback' in window
          ? requestIdleCallback(ahead, { timeout: 1500 })
          : setTimeout(ahead, 300);
      if (document.readyState === 'complete') idle();
      else addEventListener('load', idle, { once: true });
    }
  }
</script>

<script>
  import {
    SEARCH_FAILED,
    hitHtml,
    loadSearch,
    resultWords,
    search,
    searchReady,
    warmSearch,
  } from '../../lib/search';

  // results appear while typing: matching cards stay, best match first; matches on other pages are listed below
  const form = document.querySelector<HTMLFormElement>('form.search');
  const input = document.querySelector<HTMLInputElement>('#q');
  const grid = document.querySelector<HTMLElement>('.grid');
  const count = document.querySelector<HTMLElement>('.count');
  const more = document.querySelector<HTMLElement>('.more');
  if (form && input && grid && count && more) {
    const list = more.querySelector('ol')!;
    let pager: HTMLElement | null;
    let original: Element[];
    let cards: Map<string | null, HTMLAnchorElement>;
    let allText: string | null;
    let current = '';
    // what the list shows without a search; read again when a category is swapped in
    const take = () => {
      pager = document.querySelector<HTMLElement>('.pager');
      original = [...grid.children];
      cards = new Map(
        [...grid.querySelectorAll<HTMLAnchorElement>('a.card')].map((c) => [
          c.getAttribute('href'),
          c,
        ]),
      );
      allText = count.textContent;
    };
    take();
    document.addEventListener('patterns:swap', () => {
      input.value = '';
      current = '';
      take();
    });

    const restore = () => {
      grid.classList.remove('searching');
      original.forEach((el) => grid.append(el));
      cards.forEach((c) => (c.hidden = false));
      count.textContent = allText;
      more.hidden = true;
      if (pager) pager.hidden = false;
    };

    const run = async (raw: string) => {
      const q = raw.trim();
      current = q;
      history.replaceState(null, '', q ? `?q=${encodeURIComponent(q)}` : location.pathname);
      if (!q) return restore();
      if (!searchReady()) count.textContent = 'Searching…';
      let hits;
      try {
        hits = await search(q);
      } catch {
        if (q === current) count.textContent = SEARCH_FAILED;
        return;
      }
      if (!hits || q !== current) return;
      const here = hits.filter((h) => cards.has(h.url));
      const elsewhere = hits.filter((h) => !cards.has(h.url));
      grid.classList.add('searching');
      cards.forEach((c) => (c.hidden = true));
      for (const h of here) {
        const c = cards.get(h.url)!;
        c.hidden = false;
        c.classList.add('in');
        grid.append(c);
      }
      count.textContent = here.length
        ? `${resultWords(here.length, 'pattern', 'patterns')} for “${q}”`
        : elsewhere.length
          ? `No patterns here for “${q}”, see more results below.`
          : `Nothing found for “${q}”. Try a shorter word, like bag or hat.`;
      list.innerHTML = elsewhere.map(hitHtml).join('');
      more.hidden = elsewhere.length === 0;
      if (pager) pager.hidden = true;
    };

    input.addEventListener('input', () => run(input.value));
    input.addEventListener('focus', () => void loadSearch().catch(() => undefined), { once: true });
    warmSearch();
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      run(input.value);
      input.blur();
    });
    const start = new URLSearchParams(location.search).get('q');
    if (start) {
      input.value = start;
      run(start);
    }
  }
</script>

<style>
  .guide {
    margin: 56px 0 0;
    padding-top: 36px;
    border-top: 1px solid rgb(42 41 37 / 0.12);
  }
  @media (min-width: 900px) {
    .guide {
      margin-top: 80px;
      padding-top: 48px;
    }
  }
  .search {
    position: relative;
    max-width: 560px;
    margin: 24px 0 0;
  }
  .search input {
    width: 100%;
    height: 54px;
    padding: 0 20px 0 50px;
    border: 1px solid rgb(42 41 37 / 0.18);
    border-radius: 3px;
    background: var(--sheet);
    font: 17px var(--sans);
    color: var(--ink);
    -webkit-appearance: none;
    appearance: none;
  }
  .search input::placeholder {
    color: var(--muted);
  }
  .search svg {
    position: absolute;
    left: 18px;
    top: 50%;
    width: 20px;
    height: 20px;
    transform: translateY(-50%);
    fill: none;
    stroke: var(--muted);
    stroke-width: 2;
    stroke-linecap: round;
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin: 16px 0 14px;
  }
  .count {
    margin: 0;
    font-size: 15px;
    color: var(--muted);
  }
  .toggle {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    font: 600 15px/1 var(--sans);
    text-decoration: none;
  }
  /* a square box that gets a tick, like a pattern checklist */
  .switch {
    position: relative;
    width: 20px;
    height: 20px;
    border-radius: 3px;
    box-shadow: inset 0 0 0 1.5px var(--ink);
    transition: background-color 0.2s;
  }
  .on .switch {
    background: var(--ink);
  }
  .on .switch::after {
    content: '';
    position: absolute;
    top: 3px;
    left: 7px;
    width: 5px;
    height: 10px;
    border: solid #fff;
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 26px 14px;
  }
  .grid.searching .feed-ad {
    display: none;
  }
  /* a category still on its way dims the old patterns, only if it takes more than a moment */
  .grid[aria-busy='true'] {
    opacity: 0.55;
    transition: opacity 0.2s 0.12s;
  }
  @media (prefers-reduced-motion: reduce) {
    .grid[aria-busy='true'] {
      transition: none;
    }
  }
  .more {
    margin: 40px 0 0;
  }
  .more h2 {
    margin: 0 0 4px;
    font: 400 26px/1.2 var(--serif);
  }
  .feed-ad {
    grid-column: 1 / -1;
  }
  .feed-ad :global(.ad) {
    margin: 4px 0;
  }
  .empty {
    margin: 40px 0 0;
    padding: 32px 24px;
    border-radius: 6px;
    background: var(--sheet);
    box-shadow: 0 1px 0 rgb(42 41 37 / 0.1);
  }
  .empty h2 {
    margin: 0 0 8px;
    font-size: 30px;
    line-height: 1.1;
  }
  .empty p {
    margin: 0 0 20px;
    color: var(--muted);
  }
