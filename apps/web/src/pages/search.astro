---
import PageHead from '../components/PageHead.astro';
import Base from '../layouts/Base.astro';
---

<Base
  title="Search | Crochet Simplified"
  description="Search Crochet Simplified patterns and journal stories."
  current="patterns"
  noindex
>
  <div class="wrap">
    <PageHead title="Search">
      <form class="search" role="search" action="/search/" method="get">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="11" cy="11" r="6.5"></circle>
          <path d="m16 16 4 4"></path>
        </svg>
        <label class="visually-hidden" for="q">
          Search patterns and stories
        </label>
        <input
          id="q"
          name="q"
          type="search"
          placeholder="Search patterns and stories"
          autocomplete="off"
        />
      </form>
    </PageHead>
    <p class="status" role="status" aria-live="polite"></p>
    <ol class="results"></ol>
  </div>
</Base>

<script>
  import {
    SEARCH_FAILED,
    hitHtml,
    loadSearch,
    resultWords,
    search,
    searchReady,
  } from '../lib/search';

  const input = document.querySelector<HTMLInputElement>('#q')!;
  const status = document.querySelector<HTMLElement>('.status')!;
  const list = document.querySelector<HTMLOListElement>('.results')!;
  let current = '';

  async function run(q: string) {
    const query = q.trim();
    current = query;
    history.replaceState(null, '', query ? `?q=${encodeURIComponent(query)}` : location.pathname);
    if (!query) {
      list.replaceChildren();
      status.textContent = '';
      return;
    }
    if (!searchReady()) status.textContent = 'Searching…';
    let results;
    try {
      results = await search(query);
    } catch {
      if (query === current) status.textContent = SEARCH_FAILED;
      return;
    }
    if (!results || query !== current) return;
    status.textContent = results.length
      ? `${resultWords(results.length, 'result', 'results')} for “${query}”`
      : `Nothing found for “${query}”. Try a shorter word, like bag or hat.`;
    list.innerHTML = results.map(hitHtml).join('');
  }

  input.addEventListener('input', () => run(input.value));
  input.addEventListener('focus', () => void loadSearch().catch(() => undefined), { once: true });
  document.querySelector('form')!.addEventListener('submit', (e) => {
    e.preventDefault();
    run(input.value);
    input.blur();
  });
  const start = new URLSearchParams(location.search).get('q');
  if (start) {
    input.value = start;
    run(start);
  } else input.focus();
</script>

<style>
  .search {
    position: relative;
    max-width: 640px;
    margin: 24px 0 0;
  }
  .search input {
    width: 100%;
    height: 56px;
    padding: 0 20px 0 50px;
    border: 1px solid rgb(42 41 37 / 0.18);
    border-radius: 3px;
    background: var(--sheet);
    font: 17px var(--sans);
    color: var(--ink);
    -webkit-appearance: none;
    appearance: none;
  }
  .search svg {
    position: absolute;
    left: 18px;
    top: 50%;
    width: 20px;
    height: 20px;
    transform: translateY(-50%);
    fill: none;
    stroke: var(--muted);
    stroke-width: 2;
    stroke-linecap: round;
  }
  .status {
    min-height: 1.5em;
    margin: 20px 0 8px;
    color: var(--muted);
  }
  /* room for the results from the start, so the footer never jumps when they arrive */
  .results {
    min-height: 100svh;
  }
</style>
