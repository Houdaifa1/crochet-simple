---
import { Picture, getImage } from 'astro:assets';
import { sharpCapped } from '../lib/sizes';
import { getEntry } from 'astro:content';
import Blocks from '../components/Blocks.astro';
import ProfileCard from '../components/ProfileCard.astro';
import SocialLinks from '../components/SocialLinks.astro';
import Base from '../layouts/Base.astro';
import heroPhoto from '../assets/story/00-yarn-hero.png';
import { isFree, patterns, settings } from '../lib/content';
import { needsFreePage, withBrand } from '../lib/seo';

const page = (await getEntry('pages', 'about'))?.data;
const s = await settings();
const all = await patterns();
const hasFree = all.some(isFree);
const hasPaid = all.some((pattern) => !isFree(pattern));
const freeHref = needsFreePage(all.map(isFree)) ? '/patterns/free/' : '/patterns/';
const image = page?.image ?? heroPhoto;
const share = await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const opening = page?.body[0]?.type === 'paragraph' ? page.body[0] : undefined;
const remaining = opening ? page!.body.slice(1) : (page?.body ?? []);
const photos = remaining.filter((block) => block.type === 'image');
const story = remaining.filter((block) => block.type !== 'image');
const site = Astro.site;
const jsonLd = site
  ? [
      {
        '@context': 'https://schema.org',
        '@type': 'AboutPage',
        url: new URL('/about/', site).href,
        mainEntity: {
          '@type': 'Organization',
          name: 'Crochet Simplified',
          url: site.href,
          logo: new URL('/logo.png', site).href,
          ...(s.contactEmail ? { email: s.contactEmail } : {}),
          sameAs: [s.pinterest?.url, s.etsyShopUrl, ...s.social.map((x) => x.url)].filter(Boolean),
        },
      },
    ]
  : [];
const imageAlt = page?.image
  ? (page.imageAlt ?? '')
  : 'Indigo, sage and clay cotton yarn on linen with a crochet hook';
---

<Base
  title={withBrand(page?.seoTitle ?? 'About')}
  description={
    page?.seoDescription ??
    'Crochet Simplified shares crochet patterns and tutorials with clear steps, good photos and printable PDFs.'
  }
  current="about"
  image={share.src}
  jsonLd={jsonLd}
>
  <div class="wrap">
    <header class="hero">
      <div class="hero-copy">
        <p class="eyebrow">About Crochet Simplified</p>
        <h1 class="statement">{page?.intro ?? 'Good patterns. More time for making.'}</h1>
        <div class="lede prose">
          {opening ? (
            <Blocks blocks={[opening]} />
          ) : (
            <p>Clear crochet patterns, useful details and printable PDFs for your next project.</p>
          )}
        </div>
        <a class="btn" href={hasFree ? freeHref : '/patterns/'}>
          {hasFree ? 'Browse free patterns' : 'Browse patterns'}
        </a>
      </div>
      <div
        class:list={['pinboard', { single: photos.length < 2 }]}
        aria-label="From the pattern collection"
      >
        <figure class="photo main-photo">
          <Picture
            src={image}
            alt={imageAlt}
            formats={['avif', 'webp']}
            fallbackFormat="jpg"
            widths={[320, 480, 640, 960, 1200]}
            sizes={sharpCapped(
              photos.length >= 2
                ? '(min-width: 1240px) 330px, (min-width: 900px) 28vw, 62vw'
                : '(min-width: 1240px) 500px, (min-width: 900px) 42vw, calc(100vw - 48px)',
            )}
            loading="eager"
            fetchpriority="high"
          />
        </figure>
        {photos.slice(0, 2).map((photo, i) => (
          <figure
            class="photo small-photo"
            style={`--order: ${i + 1}; --tilt: ${i === 0 ? 4 : -3}deg`}
          >
            <Picture
              src={photo.image}
              alt={photo.alt}
              formats={['avif', 'webp']}
              fallbackFormat="jpg"
              widths={[192, 320, 480, 640]}
              sizes={sharpCapped('(min-width: 1240px) 210px, (min-width: 900px) 17vw, 34vw')}
              loading="lazy"
            />
            {photo.caption && <figcaption>{photo.caption}</figcaption>}
          </figure>
        ))}
        <svg class="thread" viewBox="0 0 480 480" aria-hidden="true">
          <path
            pathLength="1"
            d="M12 350C48 412 168 437 200 380S152 253 229 200S397 206 404 147S364 61 467 33"
          />
        </svg>
      </div>
    </header>
    {story.length > 0 && (
      <section class="story rise">
        <h2>The story</h2>
        <div class="prose">
          <Blocks blocks={story} />
        </div>
      </section>
    )}
    {photos.length > 2 && (
      <section class="work" aria-label="More from the pattern collection">
        {photos.slice(2).map((photo) => (
          <figure class="work-photo rise">
            <Picture
              src={photo.image}
              alt={photo.alt}
              formats={['avif', 'webp']}
              fallbackFormat="jpg"
              widths={[320, 480, 720, 960, 1200]}
              sizes={sharpCapped(
                '(min-width: 1240px) 550px, (min-width: 700px) 43vw, calc(100vw - 48px)',
              )}
              loading="lazy"
            />
            {photo.caption && <figcaption>{photo.caption}</figcaption>}
          </figure>
        ))}
      </section>
    )}
    <section class="offers" aria-label="What you will find here">
      {hasFree && (
        <div class="offer rise">
          <svg viewBox="0 0 40 40" aria-hidden="true">
            <path d="M11 5h13l7 7v21a2 2 0 0 1-2 2H11a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2z" />
            <path d="M24 5v7h7M20 17v11m0 0-4-4m4 4 4-4" />
          </svg>
          <h2>Free patterns</h2>
          <p>Download the PDF, print it and start. No account needed.</p>
          <a class="link" href={freeHref}>
            Browse free patterns
          </a>
        </div>
      )}
      {hasPaid && s.etsyShopUrl && (
        <div class="offer rise">
          <svg viewBox="0 0 40 40" aria-hidden="true">
            <path d="M8 14h24l-2 19a2 2 0 0 1-2 2H12a2 2 0 0 1-2-2z" />
            <path d="M14 14v-2a6 6 0 0 1 12 0v2" />
          </svg>
          <h2>Patterns on Etsy</h2>
          <p>Some designs are sold on Etsy, where your purchase and download are handled.</p>
          <a class="link" href={s.etsyShopUrl} rel="noopener" target="_blank">
            Visit the Etsy shop<span class="visually-hidden"> (opens in a new tab)</span>
          </a>
        </div>
      )}
      <div class="offer rise">
        <svg viewBox="0 0 40 40" aria-hidden="true">
          <path d="M8 8h10a4 4 0 0 1 4 4v22a3 3 0 0 0-3-3H8zM32 8H22a4 4 0 0 0-4 4v22a3 3 0 0 1 3-3h11z"></path>
        </svg>
        <h2>The journal</h2>
        <p>Tutorials, yarn notes and the stories behind each design.</p>
        <a class="link" href="/journal/">
          Read the journal
        </a>
      </div>
    </section>
    {(s.pinterest || s.social.length > 0) && (
      <div class="follow rise">
        {s.pinterest && <ProfileCard profile={s.pinterest} />}
        <SocialLinks links={s.social} />
      </div>
    )}
    <section class="contact">
      <h2>Say hello</h2>
      {s.contactEmail ? (
        <p>
          Questions about a pattern or the site? Write to{' '}
          <a href={`mailto:${s.contactEmail}`}>{s.contactEmail}</a>.
        </p>
      ) : (
        <p>
          Questions about a resource? Visit our Pinterest profile or browse the free PDF catalogue.
        </p>
      )}
    </section>
  </div>
</Base>

<script>
  const io = new IntersectionObserver(
    (entries) =>
      entries.forEach(
        (e) => e.isIntersecting && (e.target.classList.add('in'), io.unobserve(e.target)),
      ),
    { rootMargin: '0px 0px -6% 0px' },
  );
  document.querySelectorAll('.rise').forEach((el) => io.observe(el));
</script>

<style>
  .hero {
    display: grid;
    gap: 32px;
    padding-top: 36px;
  }
  .hero-copy {
    align-self: center;
  }
  .statement {
    max-width: 15ch;
    margin: 18px 0 24px;
    font: 400 clamp(42px, 10vw, 72px) / 1.03 var(--serif);
    letter-spacing: -0.045em;
    font-variation-settings: 'opsz' 144;
    text-wrap: balance;
  }
  .lede {
    max-width: 43ch;
    color: var(--muted);
  }
  .hero-copy .btn {
    margin-top: 24px;
  }
  .pinboard {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: 14px;
    align-items: center;
    padding: 22px 6px 26px;
  }
  .pinboard::before {
    content: '';
    position: absolute;
    inset: 10% 0 4%;
    z-index: -2;
    border-radius: 50%;
    background: color-mix(in srgb, var(--pink) 12%, var(--sheet));
  }
  .pinboard.single {
    grid-template-columns: 1fr;
  }
  .photo {
    margin: 0;
    min-width: 0;
    padding: 7px;
    background: var(--sheet);
    border-radius: 12px;
    box-shadow: 0 16px 35px -18px rgb(42 41 37 / 0.32);
    transform: rotate(var(--tilt, -4deg));
    animation: settle 900ms var(--ease-out) calc(var(--order, 0) * 130ms) both;
  }
  .main-photo {
    grid-row: span 2;
    animation: none;
  }
  .photo :global(img) {
    width: 100%;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    border-radius: 7px;
    background: var(--blue);
  }
  .small-photo :global(img) {
    aspect-ratio: 4 / 5;
  }
  .photo figcaption {
    padding: 8px 3px 2px;
    font: 600 12px/1.3 var(--sans);
  }
  .thread {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    overflow: visible;
    fill: none;
    stroke: var(--blue);
    stroke-width: 2;
    stroke-linecap: round;
  }
  .thread path {
    stroke-dasharray: 1;
    animation: thread-in 1600ms var(--ease-out) both;
  }
  @keyframes settle {
    from {
      opacity: 0;
      transform: translateY(24px) rotate(calc(var(--tilt, -4deg) - 6deg)) scale(0.94);
    }
  }
  @keyframes thread-in {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
  .work {
    display: grid;
    gap: 30px;
    margin: 56px 0 0;
  }
  .work-photo {
    min-width: 0;
    margin: 0;
  }
  .work-photo :global(img) {
    width: 100%;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    border-radius: 16px;
  }
  .work-photo figcaption {
    margin: 12px 0 0;
    font: 400 24px/1.2 var(--serif);
  }
  @media (min-width: 700px) {
    .work {
      grid-template-columns: 1fr 1fr;
      gap: 32px;
    }
    .work-photo:nth-child(even) {
      margin-top: 60px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .photo,
    .thread path {
      animation: none;
    }
  }
  .story {
    display: grid;
    gap: 16px;
    margin: 64px 0 0;
  }
  .story h2,
  .contact h2 {
    margin: 0;
    font-size: 34px;
    line-height: 1.05;
  }
  .offers {
    display: grid;
    gap: 14px;
    margin: 56px 0 0;
  }
  .offer {
    padding: 24px;
    border-radius: 16px;
    background: var(--sheet);
    box-shadow:
      0 1px 0 rgb(42 41 37 / 0.1),
      0 18px 40px -30px rgb(42 41 37 / 0.45);
  }
  .offer svg {
    width: 40px;
    height: 40px;
    fill: none;
    stroke: var(--blue);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .offer h2 {
    margin: 14px 0 6px;
    font-size: 24px;
  }
  .offer p {
    margin: 0;
    color: var(--muted);
  }
  .offer .link {
    display: inline-block;
    margin-top: 10px;
    padding: 10px 0;
  }
  .follow {
    display: grid;
    gap: 16px;
    margin: 32px 0 0;
  }
  .contact {
    margin: 56px 0 0;
    padding: 32px 24px;
    border-radius: 16px;
    background: var(--blue);
    color: var(--sheet);
  }
  .contact p {
    max-width: 44ch;
    margin: 10px 0 0;
    color: var(--sheet);
  }
  .contact a {
    color: var(--sheet);
  }
  .contact a:focus-visible {
    outline-color: var(--sheet);
  }
  @media (min-width: 900px) {
    .hero {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.92fr);
      gap: 64px;
      padding-top: 48px;
    }
    .pinboard {
      padding: 24px 0;
      gap: 18px;
    }
  }
  @media (min-width: 1000px) {
    .story {
      grid-template-columns: 5fr 7fr;
      gap: 64px;
    }
    .offers {
      grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
      gap: 22px;
    }
    .contact {
      padding: 48px;
    }
  }
</style>
