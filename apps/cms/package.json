{
  "name": "@crochet-simple/cms",
  "version": "1.0.0",
  "private": true,
  "description": "The Crochet Simplified admin: content, uploads and publishing. Runs locally.",
  "type": "module",
  "scripts": {
    "dev": "payload migrate && next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "payload": "payload",
    "typecheck": "tsc -p tsconfig.json",
    "setup:mac": "sh scripts/setup-mac.sh",
    "remove:mac": "sh scripts/remove-mac.sh",
    "backup": "node --experimental-strip-types --env-file=.env scripts/backup.ts",
    "reset-password": "payload run scripts/reset-password.ts",
    "cloudflare-key": "sh scripts/set-cloudflare-key.sh",
    "pull-content": "node --experimental-strip-types scripts/pull-content.ts",
    "content-current": "node --experimental-strip-types scripts/content-current.ts"
  },
  "dependencies": {
    "@crochet-simple/shared": "workspace:*",
    "@payloadcms/db-sqlite": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "graphql": "16.11.0",
    "next": "16.3.8",
    "payload": "3.90.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "6.0.3"
  }
}
