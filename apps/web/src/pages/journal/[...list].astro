---
import { Picture } from 'astro:assets';
import { sharpCapped } from '../../lib/sizes';
import AdSlot from '../../components/AdSlot.astro';
import PageHead from '../../components/PageHead.astro';
import Pager from '../../components/Pager.astro';
import Base from '../../layouts/Base.astro';
import { withBrand } from '../../lib/seo';
import {
  PAGE_SIZE,
  articles,
  formatDate,
  isoDate,
  listing,
  pageCount,
  readingMinutes,
  type Article,
} from '../../lib/content';

export async function getStaticPaths() {
  const all = await articles();
  const pages = pageCount(all.length);
  return Array.from({ length: pages }, (_, i) => ({
    params: { list: i === 0 ? undefined : `page/${i + 1}` },
    props: { items: all.slice(i * PAGE_SIZE, (i + 1) * PAGE_SIZE), page: i + 1, pages },
  }));
}

interface Props {
  items: Article[];
  page: number;
  pages: number;
}
const { items, page, pages } = Astro.props;
const [first, ...rest] = page === 1 ? items : [undefined, ...items];
const minutes = (a: Article) => readingMinutes(a.data.body, a.data.summary);
const words = await listing('journal');
const name = words.title ?? 'Journal';
const site = Astro.site;
const jsonLd =
  site && page === 1
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'Blog',
          name: 'Crochet Simplified Journal',
          url: new URL('/journal/', site).href,
          description:
            words.seoDescription ??
            'Crochet tutorials, yarn notes and the stories behind each design.',
          publisher: { '@type': 'Organization', name: 'Crochet Simplified', url: site.href },
        },
      ]
    : [];
---

<Base
  title={withBrand(`${words.seoTitle ?? name}${page > 1 ? `, Page ${page}` : ''}`)}
  description={
    words.seoDescription ?? 'Crochet tutorials, yarn notes and the stories behind each design.'
  }
  current="journal"
  ads
  noindex={items.length === 0}
  jsonLd={jsonLd}
>
  <div class="wrap">
    <PageHead
      eyebrow={words.eyebrow ?? 'Notes from the studio'}
      title={name}
      intro={words.intro ?? 'Tutorials, yarn notes and the stories behind each design.'}
    />
    {items.length === 0 && (
      <section class="empty">
        <h2>The first stories are on their way</h2>
        <p>
          Tutorials and notes from the studio will appear here. The patterns are ready to browse.
        </p>
        <a class="btn" href="/patterns/">
          Browse patterns
        </a>
      </section>
    )}
    {first && (
      <a class="featured rise" href={`/journal/${first.id}/`}>
        <div class="media">
          <Picture
            src={first.data.cover}
            alt=""
            formats={['avif', 'webp']}
            fallbackFormat="jpg"
            widths={[480, 720, 960, 1280]}
            sizes={sharpCapped(
              '(min-width: 1240px) 540px, (min-width: 1000px) 43vw, calc(100vw - 48px)',
            )}
            loading="eager"
            decoding="auto"
            fetchpriority="high"
          />
        </div>
        <div class="text">
          <p class="kicker">{[first.data.topic, 'Latest'].filter(Boolean).join(' · ')}</p>
          <h2>{first.data.title}</h2>
          <p class="ex">{first.data.summary}</p>
          <p class="when">
            <time datetime={isoDate(first.data.published)}>{formatDate(first.data.published)}</time>{' '}
            · {minutes(first)} min read
          </p>
        </div>
      </a>
    )}
    {rest.length > 0 && (
      <div class="list">
        {rest.map((a, i) => (
          <>
            <a class="post rise" href={`/journal/${a!.id}/`}>
              <div>
                {a!.data.topic && <p class="kicker">{a!.data.topic}</p>}
                <h2>{a!.data.title}</h2>
                <p class="ex">{a!.data.summary}</p>
                <p class="when">
                  <time datetime={isoDate(a!.data.published)}>{formatDate(a!.data.published)}</time>{' '}
                  · {minutes(a!)} min read
                </p>
              </div>
              <Picture
                src={a!.data.cover}
                alt=""
                formats={['avif', 'webp']}
                fallbackFormat="jpg"
                widths={[320, 480, 720, 960]}
                sizes={sharpCapped(
                  '(min-width: 1240px) 540px, (min-width: 700px) 43vw, calc(100vw - 48px)',
                )}
                loading="lazy"
              />
            </a>
            {i === 1 && rest.length > 3 && (
              <div class="feed-ad">
                <AdSlot kind="inFeed" />
              </div>
            )}
          </>
        ))}
      </div>
    )}
    <Pager base="/journal/" current={page} total={pages} />
    {items.length > 0 && (
      <section class="practice">
        <div>
          <p class="eyebrow">A little practice goes a long way</p>
          <h2>Put your next stitch to work.</h2>
          <p>Find a project, read the notes and make it your own.</p>
        </div>
        <a class="btn" href="/patterns/">
          Browse patterns
        </a>
      </section>
    )}
  </div>
</Base>

<script>
  const io = new IntersectionObserver(
    (entries) =>
      entries.forEach(
        (e) => e.isIntersecting && (e.target.classList.add('in'), io.unobserve(e.target)),
      ),
    { rootMargin: '0px 0px -6% 0px' },
  );
  document.querySelectorAll('.rise').forEach((el) => io.observe(el));
</script>

<style>
  .featured {
    display: block;
    margin: 30px 0 0;
    text-decoration: none;
    background: var(--sheet);
    border-radius: 20px;
    overflow: hidden;
  }
  .featured .text {
    padding: 4px 24px 28px;
  }
  .featured:hover h2,
  .post:hover h2 {
    color: var(--blue);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }
  .media {
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: var(--sheet);
  }
  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 0%;
    transition: transform 1.1s var(--ease-out);
  }
  :global(html.js) .featured:not(.in) .media :global(img) {
    transform: scale(1.06);
  }
  .kicker {
    margin: 18px 0 0;
    font: 600 14px/1.2 var(--sans);
    color: var(--blue);
  }
  .featured h2 {
    margin: 10px 0 0;
    font-size: clamp(32px, 8vw, 52px);
    line-height: 1.02;
    letter-spacing: -0.03em;
  }
  .ex {
    margin: 10px 0 0;
    max-width: 44ch;
    font-size: 18px;
    color: var(--muted);
  }
  .when {
    margin: 10px 0 0;
    font-size: 14px;
    color: var(--muted);
  }
  .list {
    display: grid;
    gap: 32px;
    margin: 40px 0 0;
  }
  .post {
    display: flex;
    flex-direction: column-reverse;
    gap: 20px;
    align-items: stretch;
    text-decoration: none;
    min-width: 0;
  }
  .post .kicker {
    margin: 0;
  }
  .post h2 {
    margin: 10px 0 0;
    font-size: 32px;
    line-height: 1.1;
    letter-spacing: -0.025em;
  }
  .post .ex {
    font-size: 17px;
  }
  .post .when {
    margin-top: 12px;
  }
  .post :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 0%;
    border-radius: 16px;
  }
  .post :global(picture) {
    display: block;
    overflow: hidden;
    border-radius: 16px;
  }
  .post :global(img),
  .featured {
    transition: transform 450ms var(--ease-out);
  }
  @media (hover: hover) {
    .post:hover :global(img) {
      transform: scale(1.025);
    }
  }
  @media (min-width: 700px) {
    .list {
      grid-template-columns: 1fr 1fr;
      column-gap: 32px;
    }
    .post:nth-child(even) {
      margin-top: 56px;
    }
  }
  .feed-ad :global(.ad) {
    margin: 20px 0;
  }
  .empty {
    margin: 40px 0 0;
    padding: 32px 24px;
    border-radius: 6px;
    background: var(--sheet);
    box-shadow: 0 1px 0 rgb(42 41 37 / 0.1);
  }
  .empty h2 {
    margin: 0 0 8px;
    font-size: 30px;
    line-height: 1.1;
  }
  .empty p {
    margin: 0 0 20px;
    color: var(--muted);
  }
  .practice {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: 28px 24px;
    margin-top: 52px;
    border-radius: 16px;
    background: var(--blue);
    color: var(--sheet);
  }
  .practice .eyebrow {
    color: var(--sheet);
  }
  .practice h2 {
    max-width: 18ch;
    margin: 12px 0;
    font-size: 36px;
    line-height: 1.08;
  }
  .practice p:not(.eyebrow) {
    margin: 0;
  }
  .practice .btn {
    align-self: start;
    background: var(--sheet);
    color: var(--blue);
  }
  .practice .btn:focus-visible {
    outline-color: var(--sheet);
  }
  @media (prefers-reduced-motion: reduce) {
    .media :global(img),
    .post :global(img),
    .featured {
      transition: none;
      transform: none;
    }
  }
  @media (min-width: 1000px) {
    .featured {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 32px;
      align-items: center;
    }
    .featured .text {
      padding: 24px 32px 28px 0;
    }
    .media {
      aspect-ratio: 4 / 5;
    }
    .practice {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      padding: 40px;
    }
    .practice .btn {
      align-self: center;
      flex: none;
    }
    .feed-ad {
      grid-column: 1 / -1;
    }
  }
</style>
