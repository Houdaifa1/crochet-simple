---
import AdSlot from '../../components/AdSlot.astro';
import Chips from '../../components/Chips.astro';
import PageHead from '../../components/PageHead.astro';
import Pager from '../../components/Pager.astro';
import PatternCard from '../../components/PatternCard.astro';
import Base from '../../layouts/Base.astro';
import {
  PAGE_SIZE,
  absolute,
  categories,
  isFree,
  listing,
  pageCount,
  patterns,
  type Category,
  type Pattern,
} from '../../lib/content';

export async function getStaticPaths() {
  const all = await patterns();
  const cats = await categories();
  const scopes: { category: Category | null; list: Pattern[] }[] = [
    { category: null, list: all },
    ...cats.map((c) => ({ category: c.category, list: c.patterns })),
  ];
  const names = new Map(cats.map((c) => [c.category.id, c.category.data.name]));
  return scopes.flatMap(({ category, list }) =>
    [false, true].flatMap((free) => {
      const shown = free ? list.filter(isFree) : list;
      if (free && shown.length === 0) return [];
      const base = `/patterns/${category ? `category/${category.id}/` : ''}${free ? 'free/' : ''}`;
      const chips = cats
        .map((c) => ({
          category: c.category,
          count: (free ? c.patterns.filter(isFree) : c.patterns).length,
        }))
        .filter((c) => c.count > 0);
      const freeHere = list.some(isFree);
      const pages = pageCount(shown.length);
      return Array.from({ length: pages }, (_, i) => {
        const n = i + 1;
        const rest = `${base.slice('/patterns/'.length)}${n > 1 ? `page/${n}/` : ''}`.replace(
          /\/$/,
          '',
        );
        return {
          params: { list: rest || undefined },
          props: {
            category,
            free,
            freeHere,
            base,
            page: n,
            pages,
            total: shown.length,
            items: shown
              .slice(i * PAGE_SIZE, n * PAGE_SIZE)
              .map((p) => ({ p, name: names.get(p.data.category.id)! })),
            chips,
            chipTotal: (free ? all.filter(isFree) : all).length,
          },
        };
      });
    }),
  );
}

const { category, free, freeHere, base, page, pages, total, items, chips, chipTotal } = Astro.props;
const name = category?.data.name;
const words = await listing('patterns');
const h1 = free
  ? name
    ? `Free ${name.toLowerCase()} patterns`
    : 'Free patterns'
  : (name ?? words.title ?? 'Patterns');
const what = `${free ? 'Free ' : ''}${name ? `${name} ` : ''}Crochet Patterns`;
const title = `${what}${page > 1 ? `, Page ${page}` : ''} | Crochet Simple`;
// the admin's text when it is long enough to describe the page in search results
const own = category?.data.description;
const description =
  own && own.length >= 70
    ? own
    : name
      ? `${free ? 'Free ' : ''}${name} crochet patterns from Crochet Simple, with clear steps, good photos${free ? ' and a printable PDF' : ''}.`
      : free
        ? 'Free crochet patterns with clear steps, good photos and a printable PDF you can download right away.'
        : (words.seoDescription ??
          'Crochet patterns with clear steps and good photos: bags, accessories, home pieces, hats and more.');
const intro = free
  ? 'Download the PDF, print it and start. No account needed.'
  : (category?.data.description ??
    words.intro ??
    'Clear steps, good photos and a finished piece you will actually use.');
const toggleHref = free
  ? `/patterns/${category ? `category/${category.id}/` : ''}`
  : `${base}free/`;
const site = Astro.site;
const crumbs = [
  { name: 'Patterns', path: '/patterns/' },
  ...(category ? [{ name: category.data.name, path: `/patterns/category/${category.id}/` }] : []),
  ...(free ? [{ name: 'Free', path: base }] : []),
];
const jsonLd = site
  ? [
      {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: crumbs.map((c, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: c.name,
          item: absolute(c.path, site),
        })),
      },
    ]
  : [];
---

<Base title={title} description={description} current="patterns" jsonLd={jsonLd} ads>
  <div class="wrap">
    <PageHead
      eyebrow={free ? 'Free crochet patterns' : (words.eyebrow ?? 'Crochet patterns')}
      title={h1}
      intro={intro}
    >
      <form class="search" role="search" action="/search/" method="get">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="11" cy="11" r="6.5"></circle>
          <path d="m16 16 4 4"></path>
        </svg>
        <label class="visually-hidden" for="q">
          Search patterns
        </label>
        <input id="q" name="q" type="search" placeholder="Search patterns" autocomplete="off" />
      </form>
    </PageHead>
    {total === 0 ? (
      <section class="empty">
        <h2>The first patterns are on their way</h2>
        <p>
          New patterns are added here as they are finished. The journal has tutorials to start with.
        </p>
        <a class="btn" href="/journal/">
          Read the journal
        </a>
      </section>
    ) : (
      <>
        {chips.length > 1 && (
          <Chips items={chips} total={chipTotal} current={category?.id ?? null} free={free} />
        )}
        <div class="bar">
          <p class="count">
            {total} {total === 1 ? 'pattern' : 'patterns'}
            {pages > 1 && ` · page ${page} of ${pages}`}
          </p>
          {freeHere && (
            <a class:list={['toggle', { on: free }]} href={toggleHref}>
              <span class="switch" aria-hidden="true" />
              Free only<span class="visually-hidden">{free ? ' (on, show all)' : ' (off)'}</span>
            </a>
          )}
        </div>
        <div class="grid">
          {items.map(({ p, name: cat }, i) => (
            <>
              <PatternCard pattern={p} category={cat} eager={i < 2} priority={i === 0} />
              {i === 3 && items.length > 4 && (
                <div class="feed-ad">
                  <AdSlot kind="inFeed" />
                </div>
              )}
            </>
          ))}
        </div>
        <Pager base={base} current={page} total={pages} />
      </>
    )}
  </div>
</Base>

<script>
  const io = new IntersectionObserver(
    (entries) =>
      entries.forEach(
        (e) => e.isIntersecting && (e.target.classList.add('in'), io.unobserve(e.target)),
      ),
    { rootMargin: '0px 0px -6% 0px' },
  );
  document.querySelectorAll('.rise').forEach((el, i) => {
    (el as HTMLElement).style.transitionDelay = `${(i % 4) * 60}ms`;
    io.observe(el);
  });
</script>

<style>
  .search {
    position: relative;
    max-width: 560px;
    margin: 24px 0 0;
  }
  .search input {
    width: 100%;
    height: 54px;
    padding: 0 20px 0 50px;
    border: 1px solid rgb(42 41 37 / 0.14);
    border-radius: 999px;
    background: #fffdf9;
    font: 17px var(--sans);
    color: var(--ink);
    -webkit-appearance: none;
    appearance: none;
  }
  .search input::placeholder {
    color: #6e675c;
  }
  .search svg {
    position: absolute;
    left: 18px;
    top: 50%;
    width: 20px;
    height: 20px;
    transform: translateY(-50%);
    fill: none;
    stroke: var(--muted);
    stroke-width: 2;
    stroke-linecap: round;
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin: 16px 0 14px;
  }
  .count {
    margin: 0;
    font-size: 15px;
    color: var(--muted);
  }
  .toggle {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    font: 600 15px/1 var(--sans);
    text-decoration: none;
  }
  .switch {
    position: relative;
    width: 44px;
    height: 26px;
    border-radius: 999px;
    background: rgb(42 41 37 / 0.18);
    transition: background-color 0.2s;
  }
  .switch::after {
    content: '';
    position: absolute;
    top: 3px;
    left: 3px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.2);
    transition: transform 0.25s var(--ease-out);
  }
  .on .switch {
    background: var(--blue);
  }
  .on .switch::after {
    transform: translateX(18px);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 26px 14px;
  }
  .feed-ad {
    grid-column: 1 / -1;
  }
  .feed-ad :global(.ad) {
    margin: 4px 0;
  }
  .empty {
    margin: 40px 0 0;
    padding: 32px 24px;
    border-radius: 22px;
    background: #fffdf9;
    box-shadow: 0 1px 0 rgb(42 41 37 / 0.1);
  }
  .empty h2 {
    margin: 0 0 8px;
    font-size: 30px;
    line-height: 1.1;
  }
  .empty p {
    margin: 0 0 20px;
    color: var(--muted);
  }
  @media (min-width: 700px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 36px 22px;
    }
  }
  @media (min-width: 1100px) {
    .grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
