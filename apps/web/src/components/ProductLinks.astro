---
interface Props {
  product?: { title: string; url: string; pinterestUrl?: string | undefined } | undefined;
}
const { product } = Astro.props;
---

{product && (
  <nav class="product-links" aria-label={`${product.title} links`}>
    <a href={product.url}>Get the pattern</a>
    {product.pinterestUrl && (
      <a href={product.pinterestUrl} target="_blank" rel="noopener">
        View on Pinterest<span class="visually-hidden"> (opens in a new tab)</span>
      </a>
    )}
  </nav>
)}

<style>
  .product-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 16px;
    padding-top: 4px;
    font: 600 14px/1.3 var(--sans);
  }
  a {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    color: var(--blue);
    text-underline-offset: 4px;
  }
  a:hover {
    text-decoration-thickness: 2px;
  }
  a:active {
    opacity: 0.8;
  }
  a:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: 4px;
  }
</style>
