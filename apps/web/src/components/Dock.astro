---
interface Props {
  current: 'home' | 'patterns' | 'journal' | 'about' | 'none';
}
const { current } = Astro.props;
const at = (name: Props['current']) => (name === current ? 'page' : undefined);
---

<nav class="dock" aria-label="Main">
  <a class="home" href="/" aria-current={at('home')} aria-label="Home">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M4 10.5 12 4l8 6.5V19a1 1 0 0 1-1 1h-4.5v-5.5h-5V20H5a1 1 0 0 1-1-1z"></path>
    </svg>
  </a>
  <a href="/patterns/" aria-current={at('patterns')}>
    Patterns
  </a>
  <a href="/journal/" aria-current={at('journal')}>
    Journal
  </a>
  <a href="/about/" aria-current={at('about')}>
    About
  </a>
</nav>

<script>
  import { prefetch } from 'astro:prefetch';

  // the menu's pages load in the background only once this page has fully loaded
  const ahead = () =>
    document
      .querySelectorAll<HTMLAnchorElement>('.dock a:not([aria-current])')
      .forEach((a) => prefetch(a.href));
  if (document.readyState === 'complete') ahead();
  else addEventListener('load', ahead, { once: true });
</script>
